# Copy to .env and fill in real values. Never commit .env.
#
# This repo now holds two runtimes that share the same problem statement:
#   * the LiveKit voice agent   (agent.py)          — sections A and C below
#   * the orchestrator service  (backend/app)       — sections B and C below
# Fill in only the section you are running; both can coexist in one .env.


# =====================================================================
# A. LiveKit voice agent (agent.py)
# =====================================================================

# --- LiveKit (transport / orchestration) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Deepgram (streaming STT) ---
DEEPGRAM_API_KEY=

# --- Groq (LLM, OpenAI-compatible endpoint) ---
GROQ_API_KEY=

# TTFA target in ms. Turns slower than this are counted as over-budget in the
# latency summary, so a good p50 cannot hide a bad tail.
TTFA_BUDGET_MS=1200

# How long a silent gap may run before the agent says one short filler phrase.
# Lower = more responsive-feeling, but fires on turns that would have been
# fine; higher = more dead air. Set very high to disable in practice.
FILLER_THRESHOLD_MS=700

# Upper bound on a tool call before it gives up and says so. An unbounded
# tool call is indistinguishable from a hung session to the user.
TOOL_TIMEOUT_S=15


# =====================================================================
# B. Orchestrator service (backend/app, FastAPI)
# =====================================================================

# Providers: mock | gemini  /  mock | rime  /  mock | livekit
LLM_PROVIDER=mock
TTS_PROVIDER=mock
REALTIME_PROVIDER=mock

# Gemini (only required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Tool simulation (seconds). Tests and the demo override this in code.
TOOL_DELAY_SECONDS=4.0


# =====================================================================
# C. Shared — Rime, and the knobs both runtimes read
# =====================================================================

# --- Rime (all spoken output, both runtimes) ---
RIME_API_KEY=
RIME_MODEL_ID=mistv2
RIME_SPEAKER=cove
# The agent pins 48000 to match LiveKit's room rate; the backend adapter
# defaults to 24000. Set per runtime if you need them to differ.
RIME_SAMPLING_RATE=24000

# Forces the simulated order lookup to take this long, so interruption and
# continuity behaviour can be exercised on demand. 0 in normal use.
# (agent.py; the backend's equivalent is TOOL_DELAY_SECONDS above.)
STRESS_TEST_TOOL_DELAY_MS=0
