# Copy to .env and fill in real values. Never commit .env.

# --- LiveKit (transport / orchestration) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Rime (all spoken output) ---
RIME_API_KEY=

# --- Deepgram (streaming STT) ---
DEEPGRAM_API_KEY=

# --- Groq (LLM, OpenAI-compatible endpoint) ---
GROQ_API_KEY=

# --- Tuning knobs (optional; defaults shown) ---

# TTFA target in ms. Turns slower than this are counted as over-budget in the
# latency summary, so a good p50 cannot hide a bad tail.
TTFA_BUDGET_MS=1200

# How long a silent gap may run before the agent says one short filler phrase.
# Lower = more responsive-feeling, but fires on turns that would have been
# fine; higher = more dead air. Set very high to disable in practice.
FILLER_THRESHOLD_MS=700

# Forces the simulated order lookup to take this long, so interruption and
# continuity behaviour can be exercised on demand. 0 in normal use.
STRESS_TEST_TOOL_DELAY_MS=0

# Upper bound on a tool call before it gives up and says so. An unbounded
# tool call is indistinguishable from a hung session to the user.
TOOL_TIMEOUT_S=15
