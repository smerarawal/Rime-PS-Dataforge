# Copy to .env and fill in local values. Never commit .env.

# Providers: mock | gemini / mock | rime  / mock | livekit
LLM_PROVIDER=mock
TTS_PROVIDER=mock
REALTIME_PROVIDER=mock

# Gemini (only required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Rime (only required when TTS_PROVIDER=rime)
RIME_API_KEY=
RIME_MODEL_ID=mistv2
RIME_SPEAKER=cove
RIME_SAMPLING_RATE=24000

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Tool simulation (seconds). Tests and the demo override this in code.
TOOL_DELAY_SECONDS=4.0
